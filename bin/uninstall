#!/usr/bin/env bash
set -euo pipefail

need_root

local _base _conf _state _log _cmd _input _hook
_base="${INSTALL_DIR:-/opt/BaToHub}"
_conf="${CONFIG_DIR:-/etc/BaToHub}"
_state="${STATE_DIR:-/var/lib/BaToHub}"
_log="${LOG_DIR:-/var/log/BaToHub}"
_cmd="/usr/local/bin/BaToHub"

echo
info "BaToHub uninstall - review before proceeding."
info ""
info "This command removes BaToHub-managed files listed below."
info "External applications such as Rebecca itself are not removed automatically."
echo
info "The following BaToHub-owned locations will be removed:"
info "  $_base"
info "  $_base/bin"
info "  $_base/core"
info "  $_base/lib"
info "  $_base/security"
info "  $_base/modules"
info "  $_base/templates"
info "  $_conf"
info "  $_state"
info "  $_log"
info "  $_cmd"
echo

if ! read -r -p "Type REMOVE to continue: " _input; then
  echo "Cancelled."
  exit 0
fi

if [ "${_input:-}" != "REMOVE" ]; then
  echo "Cancelled."
  exit 0
fi

if [ -f /etc/letsencrypt/renewal-hooks/deploy/batohub-rebecca.sh ]; then
  echo
  warn "Optional: remove the BaToHub Certbot renewal hook? [y/N]"
  if ! read -r -p "> " _hook; then
    echo "Cancelled."
    exit 0
  fi
  if [ "${_hook:-}" = "y" ] || [ "${_hook:-}" = "Y" ]; then
    rm -f /etc/letsencrypt/renewal-hooks/deploy/batohub-rebecca.sh
    info "Removed Certbot renewal hook."
  else
    info "Certbot renewal hook left in place."
  fi
fi

if [ -d "$_base" ]; then
  rm -rf "$_base"
fi

if [ -d "$_conf" ]; then
  rm -rf "$_conf"
fi

if [ -d "$_state" ]; then
  rm -rf "$_state"
fi

if [ -d "$_log" ]; then
  rm -rf "$_log"
fi

if [ -L "$_cmd" ] || [ -f "$_cmd" ]; then
  rm -f "$_cmd"
fi

echo
info "BaToHub removal finished."
