#!/usr/bin/env bash
set -Eeuo pipefail

# BaToHub uninstaller.
#
# Only files that BaToHub created are removed. Panels, their databases, their
# configuration and their certificates are never touched. Backup archives can be
# moved out of BaToHub state storage instead of being deleted.

if [[ -z "${BATOHUB_ROOT:-}" ]]; then
  self_path="${BASH_SOURCE[0]}"
  if command -v readlink >/dev/null 2>&1; then
    resolved="$(readlink -f "$self_path" 2>/dev/null || true)"
    [[ -n "$resolved" ]] && self_path="$resolved"
  fi
  BATOHUB_ROOT="$(cd "$(dirname "$self_path")/.." && pwd)"
fi
export BATOHUB_ROOT

# shellcheck source=/dev/null
. "${BATOHUB_ROOT}/lib/common.sh"
# shellcheck source=/dev/null
. "${BATOHUB_ROOT}/lib/panel_helpers.sh"

assume_yes=0
keep_backups=0
for argument in "$@"; do
  case "$argument" in
  --yes | -y) assume_yes=1 ;;
  --keep-backups) keep_backups=1 ;;
  -h | --help)
    printf 'Usage: %s [--yes] [--keep-backups]\n' "$0"
    exit 0
    ;;
  *)
    printf 'ERROR: unknown option: %s\n' "$argument" >&2
    exit 2
    ;;
  esac
done

need_root || exit 1

global_command="${GLOBAL_CMD_NAME:-/usr/local/bin/BaToHub}"

printf 'BaToHub uninstall\n'
printf '%s\n' '----------------------------------------'
printf 'The following BaToHub-managed paths will be removed:\n'
printf '  %s\n' "$INSTALL_DIR"
printf '  %s\n' "$CONFIG_DIR"
printf '  %s\n' "$STATE_DIR"
printf '  %s\n' "$LOG_DIR"
printf '  %s\n' "$global_command"
printf '\nPanels and their data are never removed. BaToHub-managed certificates\n'
printf 'live under %s and are removed with the state directory.\n' "${STATE_DIR}/panels"
printf '\n'

if [[ "$assume_yes" != 1 ]]; then
  if ! ui_confirm_phrase REMOVE 'Remove BaToHub from this server?'; then
    printf 'Cancelled. Nothing was removed.\n'
    exit 0
  fi
fi

moved_backups=""
if [[ -d "${BACKUP_DIR}" ]] && [[ -n "$(ls -A "$BACKUP_DIR" 2>/dev/null || true)" ]]; then
  if [[ "$keep_backups" != 1 ]] && [[ "$assume_yes" != 1 ]] && ui_confirm 'Keep the backup archives?'; then
    keep_backups=1
  fi
  if [[ "$keep_backups" == 1 ]]; then
    moved_backups="/var/backups/batohub-$(current_timestamp)"
    if install -d -m 0700 -o root -g root "$moved_backups" &&
      cp -a "${BACKUP_DIR}/." "$moved_backups/"; then
      chmod -R 0600 "$moved_backups"
      printf 'Backup archives kept at: %s\n' "$moved_backups"
    else
      printf 'WARNING: the backup archives could not be moved to /var/backups.\n' >&2
      printf 'They remain at: %s\n' "$BACKUP_DIR" >&2
      moved_backups=""
    fi
  fi
fi

if [[ -L "$global_command" ]]; then
  if [[ "$(readlink "$global_command")" == "${INSTALL_DIR}/bin/batohub" ]]; then
    rm -f -- "$global_command"
    printf 'Removed command link: %s\n' "$global_command"
  else
    printf 'The command path %s points elsewhere and was not removed.\n' "$global_command"
  fi
elif [[ -f "$global_command" ]]; then
  printf 'The command path %s is a regular file and was not removed.\n' "$global_command"
  printf 'Remove it manually if BaToHub created it.\n'
fi

for target in "$STATE_DIR" "$LOG_DIR" "$CONFIG_DIR" "$INSTALL_DIR"; do
  if [[ -d "$target" ]]; then
    rm -rf -- "$target"
    printf 'Removed: %s\n' "$target"
  fi
done

if [[ -n "$moved_backups" ]]; then
  printf '\nBackup archives were preserved at %s\n' "$moved_backups"
fi
printf '\nBaToHub removal finished. No panel or panel data was touched.\n'
