{
  "name": "foxima",
  "display_name": "Foxima",
  "version": "0.0.4",
  "description": "Foxima is a PHP management interface that drives several panel families. Its official installer deploys a Docker Compose stack, writes the configuration and installs its own management command, so BaToHub drives that installer and never writes the configuration, the stack or its data.",
  "service_name": "",
  "default_port": 443,
  "default_path": "/opt/faoxima",
  "config_paths": [
    "/opt/faoxima/.env",
    "/opt/faoxima/docker-compose.yml",
    "/opt/faoxima/config.php"
  ],
  "data_paths": [
    "/opt/faoxima",
    "/opt/bots"
  ],
  "requirements": [
    "docker",
    "curl",
    "wget",
    "unzip",
    "openssl"
  ],
  "supports_bare_ip_ssl": false,
  "supports_reseller": false,
  "update_method": "official Foxima management command",
  "installer_url": "https://raw.githubusercontent.com/Mmd-Amir/Faoxima/main/install.sh",
  "source_repo": "Mmd-Amir/Faoxima",
  "supports_version_pinning": true,
  "version_pin_scope": "install",
  "dev_channel_argument": "",
  "management_command": "/usr/local/bin/faoxima",
  "installer_log": "/var/log/faoxima_installer.log"
}
