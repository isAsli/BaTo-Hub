{
  "name": "rebecca",
  "display_name": "Rebecca",
  "version": "0.0.5",
  "description": "Rebecca panel integration. Rebecca is distributed as a Go binary under /opt/rebecca, or as a Docker Compose stack in the same directory.",
  "service_name": "rebecca",
  "default_port": 8000,
  "default_path": "/opt/rebecca",
  "config_paths": [
    "/opt/rebecca/.env",
    "/opt/rebecca/.channel",
    "/opt/rebecca/docker-compose.yml"
  ],
  "data_paths": [
    "/var/lib/rebecca",
    "/var/lib/rebecca/certs"
  ],
  "database_type": "sqlite|mysql|mariadb",
  "cli_name": "/opt/rebecca/bin/rebecca-cli",
  "requirements": [
    "curl",
    "ca-certificates",
    "openssl",
    "acme.sh"
  ],
  "ssl_method": "acme.sh issuance into BaToHub state storage; existing panel certificate options are updated, otherwise the operator is told which paths to configure",
  "template_method": "CUSTOM_TEMPLATES_DIRECTORY with SUBSCRIPTION_PAGE_TEMPLATE",
  "supports_bare_ip_ssl": false,
  "supports_reseller": false,
  "update_method": "official Rebecca installer script",
  "source_repo": "rebeccapanel/Rebecca",
  "supports_version_pinning": true,
  "version_pin_scope": "install-and-update",
  "dev_channel_argument": "--dev",
  "supports_docker": true,
  "docker_container_name": "rebecca",
  "nodes": {
    "supported": true,
    "api_base": "http://127.0.0.1:{port}",
    "api_auth": "bearer",
    "token_env_keys": [
      "REBECCA_API_TOKEN",
      "API_TOKEN",
      "API_KEY",
      "SECRET_KEY"
    ],
    "endpoints": {
      "list": "/api/nodes",
      "add": "/api/node",
      "remove": "/api/node/{id}",
      "restart": "/api/node/{id}/restart",
      "status": "/api/node/{id}",
      "logs": "/api/node/{id}/logs"
    },
    "list_container": "",
    "list_fields": [
      "id",
      "name",
      "address",
      "status"
    ],
    "detail_status_field": "status",
    "add_id_field": "id",
    "add_body": "{\"name\":\"{name}\",\"address\":\"{host}\",\"port\":{port},\"usage_coefficient\":1}",
    "roles": [
      "node"
    ],
    "default_role": "node",
    "default_node_port": 62050,
    "node_installer_url": "https://raw.githubusercontent.com/rebeccapanel/Rebecca/master/scripts/rebecca/rebecca-node.sh",
    "node_install_arguments": []
  },
  "users": {
    "mode": "users",
    "list_path": "/api/users",
    "list_container": "",
    "list_fields": [
      "username",
      "status",
      "expire",
      "data_limit",
      "used_traffic"
    ],
    "create_path": "/api/user",
    "create_body": "{\"username\":{username},\"status\":{status},\"expire\":{expire},\"data_limit\":{data_limit},\"proxies\":{\"vless\":{},\"vmess\":{}}}"
  }
}
