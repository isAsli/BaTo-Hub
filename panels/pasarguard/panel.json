{
  "name": "pasarguard",
  "display_name": "PasarGuard",
  "version": "0.0.5",
  "description": "PasarGuard panel integration. PasarGuard is installed under /opt/pasarguard by the official PasarGuard scripts.",
  "service_name": "pasarguard",
  "default_port": 8000,
  "default_path": "/opt/pasarguard",
  "config_paths": [
    "/opt/pasarguard/.env"
  ],
  "data_paths": [
    "/var/lib/pasarguard"
  ],
  "database_type": "sqlite|mysql|mariadb|postgresql|timescaledb",
  "cli_name": "pasarguard",
  "requirements": [
    "curl",
    "ca-certificates",
    "openssl",
    "acme.sh"
  ],
  "ssl_method": "acme.sh issuance into BaToHub state storage; existing panel certificate options in .env are updated",
  "template_method": "CUSTOM_TEMPLATES_DIRECTORY with SUBSCRIPTION_PAGE_TEMPLATE",
  "supports_bare_ip_ssl": false,
  "supports_reseller": false,
  "update_method": "official PasarGuard script",
  "source_repo": "PasarGuard/panel",
  "supports_version_pinning": true,
  "version_pin_scope": "install",
  "dev_channel_argument": "--dev",
  "supports_docker": true,
  "docker_container_name": "pasarguard",
  "nodes": {
    "supported": true,
    "api_base": "http://127.0.0.1:{port}",
    "api_auth": "login",
    "login_body": "username={user_encoded}&password={password_encoded}",
    "login_content_type": "application/x-www-form-urlencoded",
    "login_token_field": "access_token",
    "credentials": {
      "username_env": "SUDO_USERNAME",
      "password_env": "SUDO_PASSWORD"
    },
    "endpoints": {
      "login": "/api/admin/token",
      "list": "/api/nodes",
      "add": "/api/node",
      "remove": "/api/node/{id}",
      "restart": "/api/node/{id}/restart",
      "status": "/api/node/{id}",
      "logs": "/api/node/{id}/logs"
    },
    "list_container": "",
    "list_fields": [
      "id",
      "name",
      "address",
      "status"
    ],
    "detail_status_field": "status",
    "add_id_field": "id",
    "add_body": "{\"name\":\"{name}\",\"address\":\"{host}\",\"port\":{port},\"api_port\":62051,\"usage_coefficient\":1}",
    "roles": [
      "node"
    ],
    "default_role": "node",
    "default_node_port": 62050,
    "node_installer_url": "https://raw.githubusercontent.com/PasarGuard/node/main/install.sh",
    "node_install_arguments": []
  },
  "users": {
    "mode": "users",
    "list_path": "/api/users",
    "list_container": "",
    "list_fields": [
      "username",
      "status",
      "expire",
      "data_limit",
      "used_traffic"
    ],
    "create_path": "/api/user",
    "create_body": "{\"username\":{username},\"status\":{status},\"expire\":{expire},\"data_limit\":{data_limit},\"proxies\":{\"vless\":{},\"vmess\":{}}}"
  }
}
